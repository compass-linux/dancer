cabal-version: 3.0
name: dancer
version: 0.1.0.0
license: GPL-3.0-only
author: confucius40
category: System --I AM RECURSION!! I AM RECURSION!!! I AM RECURSION!!!!!

common warnings
  ghc-options: -Wall -Wcompat

executable dancer
  import: warnings
  main-is: Main.hs
  other-modules:
    Dancer.Config
    Dancer.Packages
    Dancer.Build
    Dancer.CLI
  hs-source-dirs: src
  default-language: Haskell2010
  build-depends:
    base >=4.16 && <5,
    containers,
    filepath,
    process,
    directory,
    text,
    bytestring,
    aeson,
    yaml,
    mtl,
    transformers,
    unix
